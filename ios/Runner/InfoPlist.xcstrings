{
  "sourceLanguage": "en",
  "strings": {
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Shown by iOS the first time the user picks Save Image in the share sheet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save the result image to your photo library."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç görselini fotoğraflarına kaydetmek için kullanılır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um das Ergebnisbild in deiner Fotomediathek zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para guardar la imagen del resultado en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet d’enregistrer l’image du résultat dans votre photothèque."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para salvar a imagem do resultado na sua fototeca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, чтобы сохранить изображение результата в медиатеку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لحفظ صورة النتيجة في مكتبة الصور."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नतीजे की तस्वीर आपकी फ़ोटो लाइब्रेरी में सेव करने के लिए इस्तेमाल होता है।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เพื่อบันทึกภาพผลลัพธ์ลงในคลังรูปภาพของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng để lưu ảnh kết quả vào thư viện ảnh của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk menyimpan gambar hasil ke perpustakaan foto Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk menyimpan imej keputusan ke pustaka foto anda."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과 이미지를 사진 보관함에 저장하는 데 사용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果の画像を写真ライブラリに保存するために使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将结果图片保存到你的照片图库。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
