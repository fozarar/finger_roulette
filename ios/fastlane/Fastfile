# Lane'ler `ios/` klasöründen çalıştırılır:  fastlane <lane_adı>
#
# Hesap ve bundle id Appfile'da, deliver ayarları Deliverfile'da.
# Metinlerin kaynağı ../app_store_metadata/metadata.json —
# düzenledikten sonra ../tool/gen_fastlane_metadata.py çalıştır.

default_platform(:ios)

# Surum tek kaynaktan gelsin: pubspec.yaml. Boylece fastlane hangi App Store
# surumunu duzenleyecegini tahmin etmez, acikca soyleriz.
def flutter_version
  pubspec = File.read(File.expand_path("../../pubspec.yaml", __dir__),
                      encoding: "UTF-8")
  v = pubspec[/^version:\s*(\d+\.\d+\.\d+)\+/, 1]
  UI.user_error!("pubspec.yaml icinde surum bulunamadi") if v.nil?
  v
end

# deliver, altool'un aksine Apple ID ile bir web oturumu acar. Apple'in
# Olympus ucu su an 404 dondurdugu icin o yol calismiyor — spaceship "Service
# key is empty" deyip "Could not receive latest API key" ile duruyor
# (fastlane#30199). App Store Connect API anahtari o ucu hic kullanmaz, o
# yuzden kesinti bittiginde de dogru yol odur.
#
# Anahtar App Store Connect > Users and Access > Integrations altinda
# uretilir (App Manager rolu yeter). .p8 dosyasi bir kez indirilir; depoya
# koyma, ev dizininde birak:
#
#   export ASC_KEY_ID=XXXXXXXXXX
#   export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   export ASC_KEY_PATH=~/private_keys/AuthKey_XXXXXXXXXX.p8
#
# Degiskenler yoksa nil doner ve deliver eski Apple ID yoluna duser.
def asc_api_key
  return nil if ENV["ASC_KEY_ID"].to_s.empty?

  if ENV["ASC_ISSUER_ID"].to_s.empty?
    UI.user_error!("ASC_ISSUER_ID tanimli degil. Anahtarin kendisinde yazmaz; " \
                   "App Store Connect > Users and Access > Integrations " \
                   "sayfasinin ustundeki Issuer ID alanindan kopyala.")
  end

  path = File.expand_path(ENV["ASC_KEY_PATH"].to_s)
  UI.user_error!("ASC_KEY_PATH bulunamadi: #{path}") unless File.exist?(path)

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: path,
  )
end

platform :ios do
  desc "App Store metinlerini yükler. Build'e ve ekran görüntülerine dokunmaz, " \
       "incelemeye göndermez, puanları sıfırlamaz."
  lane :metadata do
    version = flutter_version
    UI.message("Hedef App Store surumu: #{version}")

    key = asc_api_key
    if key.nil?
      UI.important("ASC_KEY_ID tanimli degil — Apple ID ile giris denenecek. " \
                   "\"Service key is empty\" hatasi alirsan Apple tarafi " \
                   "duser; Fastfile'in basindaki API anahtari notuna bak.")
    end

    deliver(
      api_key: key,
      app_version: version,
      skip_binary_upload: true,
      skip_screenshots: true,
    )
  end

  desc "Derlenmiş ipa'yı TestFlight'a yükler. Önce: flutter build ipa"
  lane :beta do
    # altool yalnizca uygulamaya ozel sifreyle calisir. Degisken yoksa fastlane
    # sessizce keychain'deki normal Apple ID sifresine duser ve Apple bunu
    # -22938 ile reddeder. Kafa karistirici hata yerine burada acikca dur.
    if ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"].to_s.empty?
      UI.user_error!("FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD tanimli degil.\n" \
                     "account.apple.com > Sign-In and Security > App-Specific Passwords " \
                     "uzerinden uret. Ekrana ve kabuk gecmisine yazilmamasi icin soyle gir:\n" \
                     "  read -s 'FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD?Sifre: ' && " \
                     "export FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD; echo")
    end

    # __dir__ = bu dosyanın klasörü (ios/fastlane). fastlane'in çalışma
    # dizinine güvenmiyoruz; yol her durumda proje köküne göre çözülsün.
    # ipa'nin adi CFBundleName'den turuyor ve uygulama adi degisince
    # degisiyor; sabit bir dosya adi yerine klasordeki en yeni ipa'yi al.
    ipas = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)]
    if ipas.empty?
      UI.user_error!("build/ios/ipa altinda ipa yok\nOnce calistir: flutter build ipa")
    end
    ipa = ipas.max_by { |f| File.mtime(f) }
    UI.message("Yuklenecek ipa: #{File.basename(ipa)}")
    upload_to_testflight(
      ipa: ipa,
      # Uygulamanin sayisal App Store Connect kimligi (Appfile'daki e-posta
      # olan apple_id ile karistirma). Verilince pilot yuklemeden once web
      # oturumu acmaz, yalnizca uygulamaya ozel sifreyle yukler. Web
      # oturumu birkac gunde dusuyor ve her acilista 2FA istiyor.
      apple_id: "6759880651",
      skip_waiting_for_build_processing: true,
    )
  end
end
