# App Store Connect metadata yükleme ayarları.
#
# Metinlerin kaynağı: ios/fastlane/metadata/<locale>/*.txt
# Bunlar app_store_metadata/metadata.json'dan üretilir — orayı düzenleyip
# tool/gen_fastlane_metadata.py çalıştır, elle iki yeri güncelleme.
#
# deliver yalnızca dosyası bulunan alanları günceller; support_url,
# marketing_url, privacy_url gibi dosyası olmayan alanlara dokunmaz.

app_identifier("com.furkanozarar.fingerroulette")

# Yükleme öncesi tarayıcıda önizleme açılsın — ilk çalıştırmalarda bırak.
# force(true) dersen önizlemeyi atlar ve doğrudan gönderir.
force(false)

# Metadata'yı inceleme için otomatik göndermez; App Store Connect'ten
# kendin "Submit for Review" dersin.
submit_for_review(false)
